# QQ bot credentials
QQ_APP_ID=
QQ_APP_SECRET=

# Administrator identities, separated by commas.
# Supported forms: user:<openid>, union:<openid>, member:<group_openid>:<member_openid>
QQ_ADMIN_OPENIDS=
QQ_READONLY_ADMIN_OPENIDS=

# Base64-encoded 32-byte random key. Keep the key with database backups.
BOT_DATA_KEY=
DATA_PATH=./data/bot.db
LISTEN_ADDR=:8080
LOG_LEVEL=info
QQ_API_TIMEOUT=10s
GATEWAY_QUEUE_SIZE=64
GATEWAY_WORKERS=2
MESSAGE_DEDUP_TTL=24h
HEALTH_HOST_PORT=18080

# RSS/Atom
RSS_ENABLED=true
RSS_POLL_INTERVAL=5m
RSS_HTTP_TIMEOUT=20s
RSS_PROXY_URL=

# LLM: base URL ends at /v1, not /chat/completions.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_SYSTEM_PROMPT=
LLM_MINUTE_LIMIT=6
LLM_DAILY_LIMIT=100
LLM_CONCURRENCY=2
LLM_QUEUE_SIZE=32
LLM_MAX_TOOLS=6
LLM_TIMEOUT_SECONDS=120
LLM_TOOL_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=2000
LLM_MAX_REPLY_RUNES=6000
LLM_CHUNK_RUNES=1500
LLM_HISTORY_TURNS=20
LLM_HISTORY_BYTES=32768
LLM_HISTORY_TTL_SECONDS=86400

# Search: off, tavily, searxng, bing_serpapi, model_native
LLM_SEARCH_BACKEND=off
LLM_TAVILY_URL=https://api.tavily.com/search
LLM_TAVILY_KEY=
LLM_SEARXNG_URL=
LLM_BING_URL=https://serpapi.com/search.json
LLM_BING_KEY=
LLM_SEARCH_MODEL_URL=
LLM_SEARCH_MODEL_KEY=
LLM_SEARCH_MODEL=
